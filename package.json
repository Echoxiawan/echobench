{
  "name": "echobench",
  "version": "1.0.1",
  "private": true,
  "description": "EchoBench — local-first Android/iOS mobile test studio with recording, replay, multi-device sync and AI CSV export",
  "author": "EchoBench contributors",
  "license": "Apache-2.0",
  "main": "dist-desktop/desktop/main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && tsc --noEmit && vite build",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "appium:setup:android": "appium driver install uiautomator2@8.7.0",
    "appium:setup:ios": "appium driver install xcuitest@12.18.1",
    "appium": "appium --port 4723 --base-path /",
    "desktop:build": "npm run build && tsc -p tsconfig.desktop.json",
    "desktop:dev": "npm run desktop:build && electron .",
    "desktop:run": "electron .",
    "desktop:prepare": "node scripts/prepare-runtime.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "appium": "3.8.0",
    "appium-uiautomator2-driver": "8.7.0",
    "fast-xml-parser": "5.3.1",
    "js-yaml": "4.1.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "concurrently": "9.1.2",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "optionalDependencies": {
    "appium-xcuitest-driver": "12.18.1"
  }
}
